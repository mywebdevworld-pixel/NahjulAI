# ── LLM backend (any OpenAI-compatible endpoint) ────────────────────────────
# Default: local Ollama (free, private). Install from https://ollama.com then:
#   ollama pull llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# Free hosted alternative — Groq (https://console.groq.com, free tier):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
#
# Or OpenRouter free models (https://openrouter.ai):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   LLM_API_KEY=sk-or-...

# ── Retrieval ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=6

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
